{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: build",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "if command -v clang++-23 >/dev/null 2>&1; then PPP_CXX=clang++-23; else PPP_CXX=clang++; fi; exec \"$PPP_CXX\" \"$@\"",
        "--",
        "-std=c++23",
        "-stdlib=libc++",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-g",
        "-fsanitize=address,undefined",
        "-fno-omit-frame-pointer",
        "-IPPP",
        "-fprebuilt-module-path=.modules",
        "${relativeFile}",
        ".modules/std.o",
        ".modules/PPP.o",
        "-o",
        "${relativeFileDirname}/${fileBasenameNoExtension}.out"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "cpp",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      "presentation": {
        "echo": false,
        "showReuseMessage": false
      },
      "detail": "Compile the current .cpp file against the std/PPP modules"
    },
    {
      "label": "C++: build & run",
      "type": "shell",
      "command": "${relativeFileDirname}/${fileBasenameNoExtension}.out",
      "dependsOn": "C++: build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "detail": "Compile then run the current .cpp file",
      "presentation": {
        "echo": false,
        "reveal": "always",
        "panel": "shared",
        "focus": true,
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
